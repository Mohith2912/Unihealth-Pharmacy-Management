{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "routes": [
    { "src": "/dashboard", "dest": "/dashboard.html" },
    { "src": "/inventory", "dest": "/inventory.html" },
    { "src": "/reservations", "dest": "/reservations.html" },
    { "src": "/alerts", "dest": "/alerts.html" },
    { "src": "/analytics", "dest": "/analytics.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}

